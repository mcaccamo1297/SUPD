Ho bisogno per ogni testo di un testo codificato ed espresso in linguaggio xml copiabile e incollabile

Assolutamente. Poiché la documentazione fornita è lo standard XACML 3.0 (eXtensible Access Control Markup Language) ma non include frammenti di sintassi XML da copiare, e XACML è un linguaggio basato su XML come descritto nel capitolo 5 (Sintassi), ho creato la sintassi XACML 3.0 completa per ogni regola.

Ho incapsulato le Regole (Rule) all'interno di una Policy generica, che è il contenitore logico standard in XACML. Ogni regola definisce un Target (a chi/cosa si applica), una Condition (la logica booleana complessa) e l'Effect (Permit o Deny).

Ecco la codifica in formato XML copiabile e incollabile per ogni testo, basata sui concetti XACML 3.0.

💻 Codifica XACML 3.0 in XML
Tutti gli esempi utilizzano lo schema XACML 3.0 standard (namespace urn:oasis:names:tc:xacml:3.0:core:schema:wd-17).

24. Food delivery and home services: Access only while in use / Disable tracking
Regola: Nega l'accesso alla posizione precisa in background, lo consente solo per il tracciamento dell'ordine con l'app aperta, e nega l'anteprima delle notifiche sulla schermata di blocco.

XML
<Policy PolicyId="urn:xacml:policy:24:GlovoPolicy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Description>Regole di accesso alla posizione per Glovo, limitato all'uso attivo.</Description>
  <Target/>

  <Rule RuleId="urn:xacml:rule:24:DenyBackgroundLocation" Effect="Deny">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Location.Precise</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:location:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">access</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#boolean">true</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:app-status:background" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#boolean"/>
      </Apply>
    </Condition>
  </Rule>

  <Rule RuleId="urn:xacml:rule:24:PermitActiveTracking" Effect="Permit">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Location.Precise</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:location:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:and">
        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:boolean-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#boolean">true</AttributeValue>
          <AttributeDesignator AttributeId="urn:xacml:context:attribute:app-status:foreground" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#boolean"/>
        </Apply>
        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">follow_order</AttributeValue>
          <AttributeDesignator AttributeId="urn:xacml:context:attribute:action-detail" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Apply>
      </Apply>
    </Condition>
  </Rule>
  
  <Rule RuleId="urn:xacml:rule:24:DenyLockedScreenPreview" Effect="Deny">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Notification.Content</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:notification:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">preview</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">locked</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:screen-status" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
  </Rule>
  
  <Rule RuleId="urn:xacml:rule:24:DefaultDeny" Effect="Deny"/>
</Policy>
