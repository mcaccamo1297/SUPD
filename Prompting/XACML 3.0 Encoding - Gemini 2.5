<Policy PolicyId="urn:xacml:policy:26:MessagingEssentialPolicy" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:permit-overrides">
  <Description>Regole di accesso limitato alle funzioni essenziali per WhatsApp/Telegram.</Description>
  <Target>
    <Subjects>
