260. Giochi e intrattenimento (Cloud Gaming): Accesso limitato
Regola: Consente Rete Prioritaria. Consente Microfono solo durante la chat multiplayer attiva. Nega Contatti, Posizione, Archiviazione Locale. Nega profilazione per pubblicità esterna.

XML
<Policy PolicyId="urn:xacml:policy:260:CloudGamingLimited" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Description>Politica di accesso limitato per servizi di cloud gaming (GeForce NOW, Xbox Cloud).</Description>
  <Target>
    <Subjects>
      <Subject>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">GeForceNOW</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">XboxCloudGaming</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
      </Subjects>
    </Target>
  </Target>

  <Rule RuleId="urn:xacml:rule:260:PermitPriorityNetwork" Effect="Permit">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Network.Access</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:network:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
    <ObligationExpressions>
      <ObligationExpression ObligationId="urn:xacml:obligation:action:set-priority" FulfillOn="Permit">
        <AttributeAssignmentExpression AttributeId="urn:xacml:attribute:network-priority">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">HighPriorityForStreaming</AttributeValue>
        </AttributeAssignmentExpression>
      </ObligationExpression>
    </ObligationExpressions>
  </Rule>

  <Rule RuleId="urn:xacml:rule:260:PermitMicForChat" Effect="Permit">
    <Target>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
