            <ResourceAttributeDesignator AttributeId="urn:xacml:location:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">search_nearby</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:action-detail" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
  </Rule>

  <Rule RuleId="urn:xacml:rule:178:DenyContactBook" Effect="Deny">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">User.ContactBook</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:data:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
  </Rule>

  <Rule RuleId="urn:xacml:rule:178:PermitCalendarOnDemand" Effect="Permit">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Device.Calendar</AttributeValue>
