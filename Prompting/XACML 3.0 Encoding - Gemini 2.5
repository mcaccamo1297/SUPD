<Policy PolicyId="urn:xacml:policy:250:NewsNoProfiling" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Description>Politica di consultazione anonima per aggregatori di notizie.</Description>
  <Target>
    <Subjects>
