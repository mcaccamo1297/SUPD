225. Utility e strumenti: Accesso limitato
Regola: Consente l'accesso a fotocamera e file solo durante la sessione di lavoro attiva. Include un "Advice" (consiglio) per revocare i permessi e cancellare la cache dopo l'esportazione.

XML
<Policy PolicyId="urn:xacml:policy:225:UtilityTemporaryAccess" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Description>Politica di accesso temporaneo per app di utility (Adobe Scan, CapCut).</Description>
  <Target>
    <Subjects>
      <Subject>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">AdobeScan</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">CapCut</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
      </Subjects>
    </Target>
  </Target>

  <Rule RuleId="urn:xacml:rule:225:PermitAccessDuringSession" Effect="Permit">
    <Target>
      <Resources>
        <AnyOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Device.Camera</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:device:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Device.Storage.Files</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:device:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
        </AnyOf>
      </Resources>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ActiveWorkSession</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:app-status" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
