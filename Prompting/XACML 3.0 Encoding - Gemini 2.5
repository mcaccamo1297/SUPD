        </Apply>
        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PreApprovedTrustedCircle</AttributeValue>
          <AttributeDesignator AttributeId="urn:xacml:context:attribute:data-recipient" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
