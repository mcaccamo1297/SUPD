        <AttributeDesignator AttributeId="urn:xacml:context:attribute:session-status" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
