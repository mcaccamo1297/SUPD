            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">send_destination_to_car</AttributeValue>
              <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">find_car_location</AttributeValue>
              <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
        </AnyOf>
      </Actions>
    </Target>
  </Rule>

  <Rule RuleId="urn:xacml:rule:266:DenyContinuousRouteRecording" Effect="Deny">
    <Target>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">record_route</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ContinuousBackground</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:execution-mode" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
  </Rule>

  <Rule RuleId="urn:xacml:rule:266:DenyDrivingTelemetry" Effect="Deny">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Vehicle.Telemetry.DrivingStyle</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:vehicle:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
  </Rule>

  <Rule RuleId="urn:xacml:rule:266:DenyContactsCalendar" Effect="Deny">
    <Target>
      <Resources>
        <AnyOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">User.ContactBook</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:data:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">User.Calendar</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:data:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
        </AnyOf>
      </Resources>
    </Target>
  </Rule>
  
  <Rule RuleId="urn:xacml:rule:266:DefaultDeny" Effect="Deny"/>
</Policy>
267. Utility e strumenti (Password Manager): Accesso completo
Regola: Consente l'accesso completo e prioritario al servizio di riempimento automatico (Autofill). Consente la sovrapposizione. Nega la Rete, tranne per la sincronizzazione manuale. Nega la raccolta di statistiche di utilizzo.

XML
<Policy PolicyId="urn:xacml:policy:267:PasswordManagerCritical" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Description>Politica di accesso critico per gestori di password (Bitwarden, 1Password).</Description>
  <Target>
    <Subjects>
      <Subject>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Bitwarden</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">1Password</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
      </Subjects>
    </Target>
  </Target>

  <Rule RuleId="urn:xacml:rule:267:PermitCriticalAutofill" Effect="Permit">
    <Target>
      <Actions>
        <AnyOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">autofill_credentials</AttributeValue>
              <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">draw_overlay</AttributeValue>
              <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
        </AnyOf>
      </Actions>
    </Target>
    <ObligationExpressions>
      <ObligationExpression ObligationId="urn:xacml:obligation:action:set-priority" FulfillOn="Permit">
        <AttributeAssignmentExpression AttributeId="urn:xacml:attribute:service-priority">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">CriticalSecurity</AttributeValue>
        </AttributeAssignmentExpression>
      </ObligationExpression>
    </ObligationExpressions>
  </Rule>

  <Rule RuleId="urn:xacml:rule:267:DenyNetworkExceptManualSync" Effect="Deny">
    <Target>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Network.Access</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:network:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:not">
        <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ManualSync</AttributeValue>
          <AttributeDesignator AttributeId="urn:xacml:context:attribute:sync-trigger" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:action" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Apply>
      </Apply>
    </Condition>
  </Rule>

  <Rule RuleId="urn:xacml:rule:267:DenyUsageStatistics" Effect="Deny">
    <Target>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">collect</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">UserData.UsageStatistics</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:data:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
  </Rule>
  
  <Rule RuleId="urn:xacml:rule:267:DefaultDeny" Effect="Deny"/>
</Policy>
268. Shopping online (Loyalty Aggregator): Accesso limitato
Regola: Consente Fotocamera solo per la scansione del codice a barre di una nuova carta ("chiedi ogni volta"). Nega Posizione, notifiche di prossimità e analisi aggregata degli acquisti.

XML
<Policy PolicyId="urn:xacml:policy:268:LoyaltyAggregatorLimited" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Description>Politica di accesso limitato per aggregatori di carte fedeltà (Stocard).</Description>
  <Target>
    <Subjects>
      <Subject>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Stocard</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
      </Subjects>
    </Target>
  </Target>

  <Rule RuleId="urn:xacml:rule:268:PermitCameraForScan" Effect="Permit">
    <Target>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">scan_barcode</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Device.Camera</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:device:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">AskEveryTime</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:permission-mode" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
  </Rule>

  <Rule RuleId="urn:xacml:rule:268:DenyLocationProximity" Effect="Deny">
    <Target>
      <Resources>
        <AnyOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Location.Any</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:location:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Notification.Proximity</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:notification:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
        </AnyOf>
      </Resources>
    </Target>
  </Rule>

  <Rule RuleId="urn:xacml:rule:268:DenyAggregatedAnalysis" Effect="Deny">
    <Target>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">analyze</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">AggregatedPurchaseData</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:data:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ConsumerProfiling</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:purpose" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
  </Rule>
  
  <Rule RuleId="urn:xacml:rule:268:DefaultDeny" Effect="Deny"/>
</Policy>
269. Hobby e interessi specifici (PlantNet, SkyView Lite): Accesso solo in uso
Regola: Consente Fotocamera e Posizione solo durante la sessione di identificazione attiva. Nega il salvataggio dei metadati di geolocalizzazione nelle foto. Nega la raccolta di dati in background.

XML
<Policy PolicyId="urn:xacml:policy:269:HobbyOnDemandAccess" Version="1.0" RuleCombiningAlgId="urn:oasis:names:tc:xacml:1.0:rule-combining-algorithm:deny-overrides">
  <Description>Politica di accesso momentaneo per app di identificazione (PlantNet, SkyView Lite).</Description>
  <Target>
    <Subjects>
      <Subject>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">PlantNet</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
        <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
          <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">SkyViewLite</AttributeValue>
          <SubjectAttributeDesignator AttributeId="urn:oasis:names:tc:xacml:1.0:subject:subject-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
        </Match>
      </Subjects>
    </Target>
  </Target>

  <Rule RuleId="urn:xacml:rule:269:PermitActiveIdentification" Effect="Permit">
    <Target>
      <Resources>
        <AnyOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Device.Camera</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:device:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
          <AllOf>
            <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
              <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Location.Any</AttributeValue>
              <ResourceAttributeDesignator AttributeId="urn:xacml:location:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
            </Match>
          </AllOf>
        </AnyOf>
      </Resources>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">identify_subject</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">ActiveIdentificationSession</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:session-status" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
  </Rule>

  <Rule RuleId="urn:xacml:rule:269:DenyGeoMetadataSave" Effect="Deny">
    <Target>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">save_metadata</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
      <Resources>
        <Resource>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Photo.GeoMetadata</AttributeValue>
            <ResourceAttributeDesignator AttributeId="urn:xacml:data:attribute:resource-type" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Resource>
      </Resources>
    </Target>
  </Rule>

  <Rule RuleId="urn:xacml:rule:269:DenyBackgroundCollection" Effect="Deny">
    <Target>
      <Actions>
        <Action>
          <Match MatchId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
            <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">collect</AttributeValue>
            <ActionAttributeDesignator AttributeId="urn:xacml:1.0:action:action-id" DataType="http://www.w3.org/2001/XMLSchema#string"/>
          </Match>
        </Action>
      </Actions>
    </Target>
    <Condition>
      <Apply FunctionId="urn:oasis:names:tc:xacml:1.0:function:string-equal">
        <AttributeValue DataType="http://www.w3.org/2001/XMLSchema#string">Background</AttributeValue>
        <AttributeDesignator AttributeId="urn:xacml:context:attribute:execution-mode" Category="urn:oasis:names:tc:xacml:3.0:attribute-category:environment" DataType="http://www.w3.org/2001/XMLSchema#string"/>
      </Apply>
    </Condition>
  </Rule>
  
  <Rule RuleId="urn:xacml:rule:269:DefaultDeny" Effect="Deny"/>
</Policy>
